{
  "name": "calorithm",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/with-local-env.mjs vite",
    "build": "tsc -b && vite build",
    "build:local": "node scripts/with-local-env.mjs npm run build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:integration": "node scripts/with-local-env.mjs vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "bundle:check": "node scripts/check-bundle.mjs",
    "types:check": "node scripts/check-types.mjs",
    "check:fast": "npm run typecheck && npm run lint && npm run test",
    "check:full": "npm run check:fast && npm run test:db && npm run test:integration && npm run types:check && npm run build:local && npm run bundle:check && npm run test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/gen-types.mjs"
  },
  "overrides": {
    "playwright-core": "1.65.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@tesseract.js-data/eng": "1.0.0",
    "barcode-detector": "3.2.3",
    "date-fns": "4.4.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "fake-indexeddb": "6.2.8",
    "fast-check": "4.10.2",
    "jsdom": "31.0.1",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
