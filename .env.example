# Names only; never commit values.
# Local work needs no env file: `npm run dev` reads these from `supabase status`.
# Production builds get them from GitHub Actions secrets.

# Project URL, for example https://PROJECT_REF.supabase.co
VITE_SUPABASE_URL=
# Publishable key, starting sb_publishable_
VITE_SUPABASE_PUBLISHABLE_KEY=
